# Copie para `.env.local` e preencha o que for usar.
# Tudo aqui é opcional: sem nenhuma variável o site funciona, o formulário
# aceita envios e o lead fica registrado no log do servidor.

# ---------------------------------------------------------------------------
# Domínio público (canonical, Open Graph, sitemap e links dos e-mails)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://redeunishop.com.br"

# ---------------------------------------------------------------------------
# E-mail transacional — Resend (https://resend.com)
# Sem as três, nenhum e-mail é enviado (os outros destinos continuam valendo).
# O domínio de LEADS_EMAIL_FROM precisa estar verificado no painel do Resend,
# senão a entrega cai em spam ou é recusada.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
LEADS_EMAIL_FROM="Rede Unishop <parceiros@redeunishop.com.br>"
# Aceita vários endereços separados por vírgula.
LEADS_EMAIL_TO="comercial@redeunishop.com.br"

# ---------------------------------------------------------------------------
# CRM — caminho 1: RD Station Marketing
# A chave é a "API key pública" em Integrações > API do painel do RD.
# O conversion_identifier é o nome que aparece nos relatórios de lá.
# ---------------------------------------------------------------------------
RD_STATION_API_KEY=""
RD_STATION_CONVERSION_ID="site-seja-parceiro"

# ---------------------------------------------------------------------------
# CRM — caminho 2: webhook genérico
# Serve para Omie, Salesforce, Pipedrive, n8n, Make, Zapier ou um endpoint
# próprio: recebe POST JSON com { evento, lead }. O token, se preenchido, vai
# no cabeçalho Authorization: Bearer.
# Os dois caminhos podem conviver — o lead vai para os dois.
# ---------------------------------------------------------------------------
CRM_WEBHOOK_URL=""
CRM_WEBHOOK_TOKEN=""

# ---------------------------------------------------------------------------
# Google Tag Manager
# Só o ID do contêiner (GTM-XXXXXXX). Vazio = nenhum script de análise carrega,
# que é o que se quer em desenvolvimento e nos previews.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=""

# ---------------------------------------------------------------------------
# CMS — Sanity (https://www.sanity.io/manage)
# Sem o PROJECT_ID o painel em /studio mostra as instruções de configuração e
# o site inteiro segue com o conteúdo versionado no repositório.
# Lembre de liberar as origens (localhost e domínio de produção) em
# API > CORS origins, com "Allow credentials" ligado.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-08-01"
# Só necessário para ler rascunhos (preview). Nunca use chave de escrita aqui.
SANITY_API_READ_TOKEN=""
